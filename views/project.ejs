<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/navbar', { onHome: false }) %>

    <%
        const idx = portfolio.projects.findIndex(p => p.slug === project.slug);
        const suivant = portfolio.projects[(idx + 1) % portfolio.projects.length];
        const ancre = project.slug === 'homelab' ? 'projet-homelab' : 'projet-' + project.slug;
    %>

    <main id="contenu" class="page-project">
        <div class="container">
            <nav class="breadcrumb" aria-label="Fil d'Ariane">
                <a href="/#<%= ancre %>">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
                    Tous les projets
                </a>
            </nav>

            <header class="project-head">
                <p class="eyebrow">Projet <%= project.id %><% if (project.wip) { %> · en cours depuis <%= project.startedAt %><% } %></p>
                <h1 class="project-head__title"><%= project.title %></h1>
                <p class="project-head__sub"><%= project.detail.subtitle %></p>
                <ul class="pills" aria-label="Technologies">
                    <% project.tech.forEach(function(t) { %><li><%= t %></li><% }); %>
                </ul>
                <% if (project.link) { %>
                <p class="project-head__link"><a class="btn btn--primary" href="<%= project.link %>" target="_blank" rel="noopener noreferrer">Ouvrir <%= project.link.replace('https://', '') %></a></p>
                <% } %>
            </header>

            <% if (project.detail.stats) { %>
            <dl class="figures figures--wide">
                <% project.detail.stats.forEach(function(stat) { %>
                <div><dt><%= stat.label %></dt><dd><%= stat.value %></dd></div>
                <% }); %>
            </dl>
            <% } %>

            <section class="project-block" aria-labelledby="vue-titre">
                <h2 class="section__title section__title--sm" id="vue-titre">Vue d'ensemble</h2>
                <p class="prose"><%= project.detail.overview %></p>
            </section>

            <% if (project.detail.features) { %>
            <section class="project-block" aria-labelledby="fonc-titre">
                <h2 class="section__title section__title--sm" id="fonc-titre">Fonctionnalités</h2>
                <ul class="features">
                    <% project.detail.features.forEach(function(feat) { %>
                    <li class="feature reveal">
                        <h3 class="feature__title"><%= feat.title %></h3>
                        <p class="feature__desc"><%= feat.desc %></p>
                        <% if (feat.highlight) { %><p class="feature__note"><%= feat.highlight %></p><% } %>
                    </li>
                    <% }); %>
                </ul>
            </section>
            <% } %>
        </div>

        <% if (project.detail.architecture) { %>
        <section class="slate slate--compact" aria-labelledby="archi-titre">
            <div class="container">
                <h2 class="slate__title slate__title--sm" id="archi-titre">Architecture technique</h2>
                <dl class="arch arch--wide">
                    <% Object.entries(project.detail.architecture).forEach(function([cle, valeur]) { %>
                    <div><dt><%= cle %></dt><dd><%= valeur %></dd></div>
                    <% }); %>
                </dl>
            </div>
        </section>
        <% } %>

        <div class="container">
            <nav class="project-next" aria-label="Suite">
                <a class="btn btn--ghost" href="/#contact">Discuter de ce projet</a>
                <a class="link" href="/projet/<%= suivant.slug %>">Projet suivant : <%= suivant.title %></a>
            </nav>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script src="/js/script.js" defer></script>
</body>
</html>
