<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/navbar', { onHome: true }) %>

    <%
        const tel = portfolio.socials.phone;
        const telHref = tel ? '+33' + tel.replace(/ /g, '').slice(1) : '';
        const statOf = (slug, label) => {
            const p = portfolio.projects.find(x => x.slug === slug);
            const s = p && p.detail && p.detail.stats.find(x => x.label === label);
            return s ? s.value : null;
        };
        // Une image par projet : capture du vrai site quand elle existe, photo sinon.
        const visuels = {
            homelab: { src: 'homelab-mains', alt: 'Deux mains qui tiennent un mini-ordinateur dans son boîtier ajouré' },
            chapitres: { src: 'chapitres-site', alt: "Page d'accueil du site meschapitres.fr" },
            cyberdef: { src: 'cyberdef-nuit', alt: 'Un jeune homme qui travaille de nuit devant ses écrans, chez lui', cadre: '--pos: 18% 30%; --zoom: 1.35; --clair: 1.25' },
            gdchess: { src: 'gdchess-coup', alt: "Une main qui déplace une pièce sur un échiquier" }
        };
        // Image responsive : WebP d'abord, JPEG en secours, deux tailles.
        const photo = (nom, alt, cls) => `<picture class="${cls || ''}">
            <source type="image/webp" srcset="/img/photos/${nom}-800.webp 800w, /img/photos/${nom}-1600.webp 1600w" sizes="(max-width: 900px) 100vw, 50vw">
            <img src="/img/photos/${nom}-1600.jpg" srcset="/img/photos/${nom}-800.jpg 800w, /img/photos/${nom}-1600.jpg 1600w" sizes="(max-width: 900px) 100vw, 50vw" alt="${alt}" loading="lazy" decoding="async">
        </picture>`;
        // Texte qui s'allume mot a mot au defilement (script.js). Sans script, il est deja allume.
        const allume = (texte) => texte.split(' ').map(m => `<span class="fill__w">${m}</span>`).join(' ');
        // Les chiffres viennent des fiches projets : rien n'est saisi deux fois.
        const chiffres = [
            { valeur: statOf('chapitres', 'Utilisateurs'), texte: 'lycéens inscrits sur Chapitres, le site de révision que je fais tourner seul' },
            { valeur: statOf('homelab', 'Services Docker'), texte: 'services en production sur mon serveur, à la maison' },
            { valeur: statOf('homelab', 'Ports exposés sur Internet'), texte: 'porte ouverte sur Internet : on y accède seulement par un réseau privé chiffré' },
            { valeur: String(portfolio.certifications.length), texte: 'certifications Cisco : réseau, cybersécurité, Python, Linux' }
        ].filter(c => c.valeur);
    %>

    <main id="contenu">

        <!-- EN-TETE : le metier en tres grand, par-dessus le portrait -->
        <section class="hero" id="accueil" aria-labelledby="hero-titre">
            <picture class="hero__portrait">
                <source srcset="/img/profile.webp" type="image/webp">
                <img src="/img/profile.jpg" alt="Portrait de <%= portfolio.name %>" width="800" height="1000" fetchpriority="high">
            </picture>

            <h1 class="hero__title" id="hero-titre">
                <span class="sr-only"><%= portfolio.name %>, technicien </span>
                <span class="hero__line">Systèmes</span>
                <span class="hero__line hero__line--in">&amp; réseaux</span>
            </h1>

            <div class="hero__intro">
                <p class="status"><span class="status__led" aria-hidden="true"></span>Disponible · alternance BTS SIO SISR</p>
                <p>Moussa Zedira, technicien informatique. Je dépanne, j'installe et je documente, du poste de l'utilisateur jusqu'au serveur.</p>
            </div>

            <p class="hero__corner hero__corner--left">Île-de-France</p>
            <a class="hero__corner hero__corner--right" href="#a-propos">Défiler <span aria-hidden="true">↓</span></a>
        </section>

        <!-- A PROPOS : une phrase qui s'allume au defilement, puis le recit -->
        <section class="about" id="a-propos" aria-labelledby="a-propos-titre">
            <h2 class="sr-only" id="a-propos-titre">À propos</h2>
            <p class="fill" data-fill><%- allume("Ce qui m'intéresse, c'est ce qui se passe derrière l'écran : les serveurs, le réseau, tout ce qui fait qu'un service tient debout.") %></p>

            <div class="about__grid">
                <p class="label">Mon départ</p>
                <div class="about__text reveal">
                    <% portfolio.story.forEach(function(para) { %>
                    <p><%= para %></p>
                    <% }); %>
                </div>
            </div>
        </section>

        <!-- PROJETS : un par ecran, numerote, avec son cartel -->
        <section class="proofs" id="preuves" aria-labelledby="preuves-titre">
            <header class="proofs__head">
                <p class="label">Projets</p>
                <h2 class="giant" id="preuves-titre">Monté<br>à la main</h2>
                <p class="proofs__intro">Des projets personnels, installés, mis en ligne et maintenus seul. Chacun montre une partie du métier.</p>
            </header>

            <% portfolio.projects.forEach(function(project, i) { const v = visuels[project.slug]; %>
            <article class="proof reveal" id="projet-<%= project.slug %>" aria-labelledby="titre-<%= project.slug %>">
                <% if (v) { %>
                <a class="proof__media<%= project.slug === 'chapitres' ? ' proof__media--screen' : '' %>" href="/projet/<%= project.slug %>" tabindex="-1" aria-hidden="true"<% if (v.cadre) { %> style="<%= v.cadre %>"<% } %>>
                    <%- photo(v.src, v.alt, 'proof__img') %>
                </a>
                <% } %>
                <div class="proof__body">
                    <p class="proof__num" aria-hidden="true"><%= i + 1 %></p>
                    <h3 class="proof__title" id="titre-<%= project.slug %>"><a href="/projet/<%= project.slug %>"><%= project.title %></a></h3>
                    <p class="proof__desc"><%= project.desc %></p>
                    <dl class="cartel">
                        <div><dt>Outils</dt><dd><%= project.tech.join(', ') %></dd></div>
                        <% if (project.wip) { %><div><dt>Depuis</dt><dd><%= project.startedAt %>, toujours en service</dd></div><% } %>
                        <% if (project.link) { %><div><dt>En ligne</dt><dd><a href="<%= project.link %>" target="_blank" rel="noopener noreferrer"><%= project.link.replace('https://', '') %></a></dd></div><% } %>
                    </dl>
                    <a class="arrow-link" href="/projet/<%= project.slug %>">Voir le projet <span aria-hidden="true">→</span></a>
                </div>
            </article>
            <% }); %>
        </section>

        <!-- EN CHIFFRES : a la place de temoignages, des faits verifiables -->
        <section class="numbers" aria-labelledby="chiffres-titre">
            <p class="label">En chiffres</p>
            <h2 class="giant giant--center" id="chiffres-titre">Ce qui<br>tourne</h2>
            <ol class="numbers__list">
                <% chiffres.forEach(function(c) { %>
                <li class="reveal">
                    <span class="numbers__value"><%= c.valeur %></span>
                    <span class="numbers__text"><%= c.texte %></span>
                </li>
                <% }); %>
            </ol>
            <%# Ces chiffres viennent de ce qui a ete construit, pour comprendre. %>
            <figure class="epigraph reveal">
                <blockquote><p>«&nbsp;Ce que je ne peux pas créer, je ne le comprends pas.&nbsp;»</p></blockquote>
                <figcaption>Richard Feynman, prix Nobel de physique</figcaption>
            </figure>
        </section>

        <!-- PARCOURS -->
        <section class="path" id="parcours" aria-labelledby="parcours-titre">
            <header class="path__head">
                <p class="label">Parcours</p>
                <h2 class="headline" id="parcours-titre">Du lycée à la salle serveur.</h2>
            </header>
            <div class="path__cols">
                <div>
                    <h3 class="path__sub">Expériences</h3>
                    <ol class="rows">
                        <% portfolio.experiences.forEach(function(exp) { %>
                        <li class="reveal">
                            <p class="rows__when"><%= exp.period %></p>
                            <div>
                                <h4 class="rows__what"><%= exp.title %></h4>
                                <p class="rows__detail"><%= exp.company %></p>
                            </div>
                        </li>
                        <% }); %>
                    </ol>
                </div>
                <div>
                    <h3 class="path__sub">Formation</h3>
                    <ol class="rows">
                        <% portfolio.formation.forEach(function(f) { %>
                        <li class="reveal">
                            <p class="rows__when"><%= f.year %></p>
                            <div>
                                <h4 class="rows__what"><%= f.title %></h4>
                                <p class="rows__detail"><%= f.school %><% if (f.detail) { %> · <%= f.detail %><% } %></p>
                            </div>
                        </li>
                        <% }); %>
                    </ol>
                </div>
            </div>
        </section>

        <!-- COMPETENCES -->
        <section class="skills" id="competences" aria-labelledby="competences-titre">
            <header class="path__head">
                <p class="label">Compétences</p>
                <h2 class="headline" id="competences-titre">Ce que je sais faire.</h2>
            </header>
            <dl class="skills__list">
                <% portfolio.skills.forEach(function(skill) { %>
                <div class="skills__row reveal">
                    <dt><%= skill.category %></dt>
                    <dd><%= skill.items.join(' · ') %></dd>
                </div>
                <% }); %>
            </dl>
            <div class="skills__extras">
                <div>
                    <h3 class="path__sub">Certifications</h3>
                    <ul class="plain">
                        <% portfolio.certifications.forEach(function(cert) { %><li><%= cert %></li><% }); %>
                    </ul>
                </div>
                <div>
                    <h3 class="path__sub">Langues</h3>
                    <ul class="plain">
                        <% portfolio.languages.forEach(function(lang) { %><li><%= lang %></li><% }); %>
                    </ul>
                </div>
            </div>
        </section>

        <!-- CONTACT -->
        <section class="contact" id="contact" aria-labelledby="contact-titre">
            <h2 class="giant" id="contact-titre">On en<br>parle ?</h2>
            <div class="contact__grid">
                <div class="contact__info">
                    <p class="contact__intro">Une alternance à proposer, une question sur un projet : appelez ou écrivez, je réponds rapidement.</p>
                    <a class="contact__mail" href="mailto:<%= portfolio.socials.email %>"><%= portfolio.socials.email %></a>
                    <dl class="coords">
                        <% if (tel) { %>
                        <div>
                            <dt>Téléphone</dt>
                            <dd><a href="tel:<%= telHref %>"><%= tel %></a> <button class="copy" type="button" data-copy="<%= tel %>">Copier</button></dd>
                        </div>
                        <% } %>
                        <div>
                            <dt>E-mail</dt>
                            <dd><a href="mailto:<%= portfolio.socials.email %>"><%= portfolio.socials.email %></a> <button class="copy" type="button" data-copy="<%= portfolio.socials.email %>">Copier</button></dd>
                        </div>
                        <div>
                            <dt>LinkedIn</dt>
                            <dd><a href="<%= portfolio.socials.linkedin %>" target="_blank" rel="noopener noreferrer">linkedin.com/in/moussa-zedira</a></dd>
                        </div>
                        <div>
                            <dt>GitHub</dt>
                            <dd><a href="<%= portfolio.socials.github %>" target="_blank" rel="noopener noreferrer">github.com/moussa-zedira</a></dd>
                        </div>
                        <div>
                            <dt>CV</dt>
                            <dd><a href="/CV.MoussaZedira.pdf?v=20261004" download>Télécharger le PDF</a></dd>
                        </div>
                    </dl>
                </div>

                <form class="form" id="contactForm" novalidate>
                    <!-- Champ piege : invisible pour les humains, rempli par les robots -->
                    <div class="hp-field" aria-hidden="true">
                        <label for="website">Site web</label>
                        <input type="text" name="website" id="website" tabindex="-1" autocomplete="off">
                    </div>
                    <div class="form__field">
                        <label for="name">Nom</label>
                        <input type="text" name="name" id="name" required maxlength="100" autocomplete="name">
                    </div>
                    <div class="form__field">
                        <label for="email">E-mail</label>
                        <input type="email" name="email" id="email" required maxlength="150" autocomplete="email">
                    </div>
                    <div class="form__field">
                        <label for="message">Message</label>
                        <textarea name="message" id="message" rows="5" required minlength="10" maxlength="5000"></textarea>
                    </div>
                    <div class="form__foot">
                        <button type="submit" class="btn btn--primary">Envoyer le message</button>
                        <p class="form__status" id="formStatus" role="status" aria-live="polite"></p>
                    </div>
                </form>
            </div>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script src="/js/script.js" defer></script>
</body>
</html>
