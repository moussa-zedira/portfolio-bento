<%#
    Barre de navigation commune. Les liens pointent vers les sections de
    l'accueil ; depuis une page projet, le prefixe "/" ramene a l'accueil.
    La section courante est marquee par script.js (aria-current).
%>
<% const base = (typeof onHome !== 'undefined' && onHome) ? '' : '/'; %>
<a class="skip-link" href="#contenu">Aller au contenu</a>
<header class="nav" id="nav">
    <div class="nav__inner">
        <a href="<%= base || '/' %>#accueil" class="nav__brand">Moussa Zedira<span class="nav__dot">.</span></a>

        <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-menu">
            <span class="nav__toggle-label">Menu</span>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>

        <nav class="nav__menu" id="nav-menu" aria-label="Navigation principale">
            <ul class="nav__links">
                <li><a href="<%= base %>#projets" data-section="projets">Projets</a></li>
                <li><a href="<%= base %>#parcours" data-section="parcours">Parcours</a></li>
                <li><a href="<%= base %>#competences" data-section="competences">Compétences</a></li>
                <li><a href="<%= base %>#contact" data-section="contact">Contact</a></li>
            </ul>
            <div class="nav__actions">
                <% if (portfolio.socials.phone) { %>
                <a class="nav__tel" href="tel:+33<%= portfolio.socials.phone.replace(/ /g, '').slice(1) %>"><%= portfolio.socials.phone %></a>
                <% } %>
                <%# Le parametre ?v= force le navigateur a retelecharger le CV apres une mise a jour du PDF. %>
                <a class="btn btn--primary btn--sm" href="/CV.MoussaZedira.pdf?v=20261004" download>
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>
                    Télécharger le CV
                </a>
            </div>
        </nav>
    </div>
</header>
