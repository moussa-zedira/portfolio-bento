<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= portfolio.name %> | <%= portfolio.title %></title>
<meta name="description" content="<%= portfolio.seeking %> — <%= portfolio.subtitle %>">
<meta name="author" content="<%= portfolio.name %>">

<!-- Open Graph / LinkedIn / WhatsApp preview -->
<meta property="og:type" content="website">
<meta property="og:title" content="<%= portfolio.name %> — <%= portfolio.title %>">
<meta property="og:description" content="<%= portfolio.seeking %>. Compétences : <%= portfolio.tags.join(', ') %>">
<meta property="og:image" content="/img/og-cover.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="628">
<meta property="og:locale" content="fr_FR">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="<%= portfolio.name %> — <%= portfolio.title %>">
<meta name="twitter:description" content="<%= portfolio.seeking %>">

<!-- Favicons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="shortcut icon" href="/favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#030305">

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">

<!-- Styles -->
<link rel="stylesheet" href="/css/style.css">
